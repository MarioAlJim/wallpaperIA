<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/settings_bg">

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/act_efecto_de_clima"
        android:textColor="@color/settings_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp" />

    <!-- Selector de Tema de la App (Auto / Claro / Oscuro) -->
    <LinearLayout
        android:id="@+id/layoutThemeMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeAuto"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/settings_chip_bg_inactive"
            app:cardBackgroundColor="@color/settings_card_bg_alt">
            <TextView
                android:id="@+id/textThemeAuto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/act_auto"
                android:gravity="center"
                android:textColor="@color/settings_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeLight"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/settings_chip_bg_inactive"
            app:cardBackgroundColor="@color/settings_card_bg_alt">
            <TextView
                android:id="@+id/textThemeLight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/act_claro"
                android:gravity="center"
                android:textColor="@color/settings_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeDark"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/settings_chip_bg_inactive"
            app:cardBackgroundColor="@color/settings_card_bg_alt">
            <TextView
                android:id="@+id/textThemeDark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/act_oscuro"
                android:gravity="center"
                android:textColor="@color/settings_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Selector de Clima -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/settings_stroke"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/settings_card_bg">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutWeather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabGravity="fill"
            app:tabMode="fixed"
            app:tabTextColor="@color/settings_text_secondary"
            app:tabSelectedTextColor="@color/settings_accent_text"
            app:tabIndicatorColor="@color/settings_accent"
            android:background="@color/settings_card_bg"
            app:tabBackground="@android:color/transparent"
            app:tabIndicatorHeight="3dp"
            app:tabRippleColor="@color/settings_accent_ripple">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/act_tormenta" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/act_da_y_noche" />

        </com.google.android.material.tabs.TabLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Contenedor del fragmento -->
    <FrameLayout
        android:id="@+id/settings_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp" />

    <!-- Apply Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonApplyWallpaper"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/act_establecer_fondo_de_pantalla"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/accent_storm"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_background"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />

</LinearLayout>
